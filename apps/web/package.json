{
  "name": "@fruiqo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-tesseract.mjs && vite --port 5173 --strictPort",
    "build": "node scripts/copy-tesseract.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fruiqo/contracts": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
