{
  "name": "@fruiqo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/main.js",
    "dev:worker": "tsc -p tsconfig.build.json && node --env-file=.env dist/worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsc -p tsconfig.build.json && node dist/eval/run-eval.js",
    "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "enrich:backfill": "node --env-file=.env --import tsx scripts/enrich-backfill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fruiqo/contracts": "workspace:*",
    "@fruiqo/taxonomy": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
