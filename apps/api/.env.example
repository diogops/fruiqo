# Copie para .env. Nunca versione o .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# App conecta com role SEM ownership (RLS se aplica). Migrações usam o owner.
DATABASE_URL=postgres://fruiqo_app:dev_app_password@127.0.0.1:55432/fruiqo
DATABASE_URL_OWNER=postgres://fruiqo_owner:dev_owner_password@127.0.0.1:55432/fruiqo
REDIS_URL=redis://:dev_redis_password@127.0.0.1:6379/0

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_RATE_LIMIT_PER_MIN=10

# SC-PERSONAL: registro fechado por padrão; libere só os e-mails listados.
REGISTRATION_ENABLED=true
ALLOWED_EMAILS=

# D-04: LLM desligado. Conteúdo real só vai à Anthropic com as duas flags true (após PEND-10).
# D-06: interpretador do "Como estou": off | rules (local, padrão) | anthropic (2d; hoje cai em rules)
AI_MODE=rules
# modelo por tarefa (só com AI_MODE=anthropic + ANTHROPIC_API_KEY): o pequeno classifica ("Como estou");
# achar títulos por descrição/print exige conhecer obras (Opus 5.5)
AI_MODEL=claude-haiku-4-5
AI_TITLES_MODEL=claude-opus-5-5
AI_MAX_INPUT_CHARS=1000
AI_DAILY_QUOTA=100
# D-24: o texto lido de um print (nunca a imagem) pode ir à IA para separar os títulos (com AI_MODE=anthropic + consentimento)
AI_OCR_TEXT_ALLOWED=false
# D-25: sugerir títulos e "melhorar resumo" (Opus 5.5); interpretar o pedido (Haiku); profundidade do raciocínio
AI_TONIGHT_MODEL=claude-opus-5-5
AI_TONIGHT_PLAN_MODEL=claude-haiku-4-5
AI_TONIGHT_EFFORT=low
# D-26: gerador de títulos na OpenAI (docs/phase0/openai-api-tos.md); falha → AI_TONIGHT_MODEL
AI_TONIGHT_TITLES_PROVIDER=anthropic
AI_TONIGHT_OPENAI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
AI_PRICE_IN_PER_MTOK=1
AI_PRICE_OUT_PER_MTOK=5
LLM_ENABLED=false
LLM_REAL_CONTENT_ALLOWED=false
LLM_MODEL=claude-opus-5-5
LLM_DAILY_QUOTA=50
LLM_MAX_INPUT_CHARS=4000
ANTHROPIC_API_KEY=

# Integrações opcionais (sem chave = recomendação fica sem resolução)
# chave v3 (32 caracteres) ou token v4/Bearer; ligar com PIPELINE_MODE=live e rodar enrich:backfill
TMDB_API_KEY=
# RF-48 (D-21): livros pela Open Library (sem chave). Contato no User-Agent (TOS-REQ-60): um e-mail ou
# URL do projeto, nunca um e-mail pessoal no repositório. Vazio = URL do repositório.
OPENLIBRARY_CONTACT=
# D-07/C-15: com o TMDB ativo (chave + PIPELINE_MODE != mock), a API recusa subir com qualquer IA ligada
# (LLM_ENABLED=true ou AI_MODE=anthropic). Só mude para `confirmed` após a resposta escrita do TMDB
# (docs/phase0/tmdb-consulta-C15.md).
TMDB_AI_CLEARANCE=pending
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
META_OEMBED_ACCESS_TOKEN=

# RF-20: live = APIs reais; mock = só gravações de fixtures/ (sem rede); record = grava em fixtures-private/.
# Em produção só live é aceito.
PIPELINE_MODE=live
# RF-28: abaixo de REVIEW_THRESHOLD o candidato vai para a fila de revisão; abaixo de DISCARD_THRESHOLD é descartado
REVIEW_THRESHOLD=0.5
DISCARD_THRESHOLD=0.15
# RF-18/19: aceita o cabeçalho X-Fruiqo-Fixture (nunca em produção)
SANDBOX_ENABLED=false
# RF-17/RF-30: origens do navegador (preview do app em :8082, sistema web Vite em :5173). Vazio = sem CORS e sem login web
WEB_ORIGIN=http://localhost:5173,http://localhost:8082
# RNF-09: preço por milhão de tokens do modelo (0 = custo estimado fica 0)
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
