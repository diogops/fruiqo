{
  "name": "@fruiqo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eas-build-post-install": "pnpm --filter @fruiqo/contracts build",
    "dev": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:4000 tcp:4000 && cross-env APP_VARIANT=development EXPO_PUBLIC_API_URL=http://10.0.2.2:4000 expo start --dev-client --port 8081",
    "dev:prod": "adb reverse tcp:8081 tcp:8081 && cross-env APP_VARIANT=development EXPO_PUBLIC_API_URL=https://api-production-b3adf.up.railway.app expo start --dev-client --port 8081",
    "web": "cross-env APP_VARIANT=development EXPO_PUBLIC_API_URL=http://localhost:4000 expo start --web --port 8082",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs --control"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@fruiqo/contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "8.0.1",
    "expo-speech-recognition": "^57.1.0",
    "expo-status-bar": "~57.0.1",
    "expo-text-extractor": "2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
