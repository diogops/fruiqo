{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview-apk": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000"
      },
      "android": { "buildType": "apk" }
    },
    "ios-sim": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "http://localhost:4000"
      },
      "ios": { "simulator": true }
    }
  }
}
